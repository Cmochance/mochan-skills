import tempfile
import time

SCRIPT_DIR = Path(__file__).resolve().parent
SKILL_ROOT = SCRIPT_DIR.parent
RENDERER_PATH = SCRIPT_DIR / "statusline.py"
DEFAULT_SKILL_CMD = "~/.gemini/config/skills/agy-statusline/scripts/statusline.py"
SHELL_WRAPPERS = frozenset({"env", "python", "python3", "sh", "bash", "zsh"})


def _load_renderer():
    spec = importlib.util.spec_from_file_location("agy_statusline_renderer", RENDERER_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Unable to load renderer module at {RENDERER_PATH}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


renderer = _load_renderer()


